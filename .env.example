# Novela - Environment Variables
# Copy this file to .env.local and fill in the values

# PostgreSQL connection string (required)
# For Supabase: Settings > Database > Connection string > URI
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Authentication (required for dashboard access)
# Choose a strong password for the admin dashboard
ADMIN_PASSWORD=
# Secret key for signing session tokens (use a random 32+ char string)
AUTH_SECRET=

# Twilio (required for SMS features)
# Get these from your Twilio console
TWILIO_AUTH_TOKEN=

# Inngest (optional, for background jobs)
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
